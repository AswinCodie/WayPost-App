# Waypost Map API Configuration
# By default, Waypost uses open tiles (CartoDB Voyager + OSM) which require NO API key.

# Option 1: Google Maps API Key
VITE_MAP_PROVIDER=google_maps
VITE_GOOGLE_MAPS_API_KEY=AIzaSyC1iyeU6frOtJSEZC_fp6qAkDrXPs97154

# Supabase (Project Settings > API)
# Use the Project URL and the browser-safe publishable/anon key. Never use service_role here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Option 2: Mapbox Access Token
# VITE_MAP_PROVIDER=mapbox
# VITE_MAPBOX_TOKEN=pk.eyJ1...your_mapbox_token_here

# Option 3: MapTiler API Key
# VITE_MAP_PROVIDER=maptiler
# VITE_MAP_API_KEY=your_maptiler_key_here

# Option 4: Stadia Maps API Key
# VITE_MAP_PROVIDER=stadia
# VITE_MAP_API_KEY=your_stadia_key_here
